RewriteEngine On

# Redirect ads.txt to AdsTxtManager
RewriteRule ^ads\.txt$ https://srv.adstxtmanager.com/19390/cuiz.in [R=301,L]

# Sitemap: redirect old URLs to the new static sitemap (to bust caches)
RewriteRule ^sitemap\.xml$ /sitemap-2026.xml [R=301,L]
RewriteRule ^api/sitemap\.xml$ /sitemap-2026.xml [R=301,L]
RewriteRule ^api/sitemap$ /sitemap-2026.xml [R=301,L]

# Don't rewrite files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for all other routes
RewriteRule ^ index.html [L]

# Cache control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
