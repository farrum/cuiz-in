RewriteEngine On

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.cuiz\.in [NC]
RewriteRule ^(.*)$ https://cuiz.in/$1 [L,R=301]

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Redirect ads.txt to AdsTxtManager
RewriteRule ^ads\.txt$ https://srv.adstxtmanager.com/19390/cuiz.in [R=301,L]

# Sitemap Proxies & SSR Rules (Canonical - Restructured paths)
<IfModule mod_proxy.c>
  SSLProxyEngine on
  RewriteRule ^sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=index [P,L]
  RewriteRule ^sitemaps/main\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=main [P,L]
  RewriteRule ^sitemaps/amp\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-amp [P,L]
  RewriteRule ^sitemaps/category/([a-z-]+)/sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=category&category=$1 [P,L]
  
  # Support old sitemap paths for backward compatibility with Google Search Console
  RewriteRule ^sitemap-main\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=main [P,L]
  RewriteRule ^sitemap-amp\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-amp [P,L]
  RewriteRule ^sitemap-cat-([a-z-]+)-sub-([a-z-]+)\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=subcategory&category=$1&sub=$2 [P,L]
  RewriteRule ^sitemap-cat-([a-z-]+)\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=category&category=$1 [P,L]
  
  # SSR for quiz question pages
  RewriteRule ^quiz/question/(.*)$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/quiz-question-ssr/$1 [P,L]
  RewriteRule ^amp/question/(.*)$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/amp-question/$1 [P,L]
</IfModule>
<IfModule !mod_proxy.c>
  RewriteRule ^sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=index [R=301,L]
  RewriteRule ^sitemaps/main\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=main [R=301,L]
  RewriteRule ^sitemaps/amp\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-amp [R=301,L]
  RewriteRule ^sitemaps/category/([a-z-]+)/sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=category&category=$1 [R=301,L]
  
  # Support old sitemap paths for backward compatibility with Google Search Console
  RewriteRule ^sitemap-main\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=main [R=301,L]
  RewriteRule ^sitemap-amp\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-amp [R=301,L]
  RewriteRule ^sitemap-cat-([a-z-]+)-sub-([a-z-]+)\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=subcategory&category=$1&sub=$2 [R=301,L]
  RewriteRule ^sitemap-cat-([a-z-]+)\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-static?type=category&category=$1 [R=301,L]
  
  # SSR for quiz question pages (Fallback to 302 redirect for bots/SEO)
  RewriteRule ^quiz/question/(.*)$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/quiz-question-ssr/$1 [R=302,L]
  RewriteRule ^amp/question/(.*)$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/amp-question/$1 [R=302,L]
</IfModule>

# Legacy and API Fallbacks
<IfModule mod_proxy.c>
  RewriteRule ^api/sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-index [P,L]
  RewriteRule ^api/sitemap$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-index [P,L]
</IfModule>
<IfModule !mod_proxy.c>
  RewriteRule ^api/sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-index [R=301,L]
  RewriteRule ^api/sitemap$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-index [R=301,L]
</IfModule>

# BOT DETECTION & PRERENDER ROUTING
# Send search engines and social bots to the Edge Function prerenderer
RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|yandex|baiduspider|facebookexternalhit|twitterbot|rogerbot|linkedinbot|embedly|quora\ link\ preview|showyoubot|outbrain|pinterest\/0\.|pinterestbot|slackbot|vkShare|W3C_Validator|whatsapp|telegrambot|applebot) [NC]
RewriteCond %{REQUEST_URI} !^/index.html$
RewriteCond %{REQUEST_URI} !^/ads\.txt$
RewriteCond %{REQUEST_URI} !^/sitemap.*\.xml$
RewriteCond %{REQUEST_URI} !^/favicon\.ico$
RewriteCond %{REQUEST_URI} !^/robots\.txt$
RewriteCond %{REQUEST_URI} !^/og-image.*\.png$
<IfModule mod_proxy.c>
  RewriteRule ^(.*)$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/prerender?path=/$1 [P,L]
</IfModule>
<IfModule !mod_proxy.c>
  RewriteRule ^(.*)$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/prerender?path=/$1 [R=302,L]
</IfModule>

# SPA fallback for all other routes (must be last to allow bot detection above)
RewriteRule ^ index.html [L]


# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Cache control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Enable WebP/AVIF content negotiation
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME}.webp -f
  RewriteRule ^(.+)\.(jpe?g|png|gif)$ $1.$2.webp [T=image/webp,L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
