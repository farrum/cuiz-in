RewriteEngine On

# Redirect ads.txt to AdsTxtManager
RewriteRule ^ads\.txt$ https://srv.adstxtmanager.com/19390/cuiz.in [R=301,L]

# Dynamic sitemap redirects to exact edge function endpoints
RewriteRule ^sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-index [R=301,L]
RewriteRule ^sitemap-main\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-main [R=301,L]
RewriteRule ^sitemap-category-history\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-history [R=301,L]
RewriteRule ^sitemap-category-science\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-science [R=301,L]
RewriteRule ^sitemap-category-geography\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-geography [R=301,L]
RewriteRule ^sitemap-category-literature\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-literature [R=301,L]
RewriteRule ^sitemap-category-entertainment\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-entertainment [R=301,L]
RewriteRule ^sitemap-category-sports\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-sports [R=301,L]
RewriteRule ^sitemap-category-technology\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-technology [R=301,L]
RewriteRule ^sitemap-category-general-knowledge\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-category-general-knowledge [R=301,L]
RewriteRule ^sitemap-amp\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-amp [R=301,L]
RewriteRule ^api/sitemap\.xml$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-index [R=301,L]
RewriteRule ^api/sitemap$ https://pgywvtphfidouakypdno.supabase.co/functions/v1/sitemap-index [R=301,L]

# Don't rewrite files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for all other routes
RewriteRule ^ index.html [L]

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.google.com https://*.googletagmanager.com https://*.googlesyndication.com https://*.gstatic.com https://*.doubleclick.net https://cdn.gpteng.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://*.googletagmanager.com https://*.doubleclick.net wss://*.supabase.co; frame-src 'self' https://*.google.com https://*.doubleclick.net https://*.googlesyndication.com; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# Cache control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Enable WebP/AVIF content negotiation
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME}.webp -f
  RewriteRule ^(.+)\.(jpe?g|png|gif)$ $1.$2.webp [T=image/webp,L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
